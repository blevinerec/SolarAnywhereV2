{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    }
  },
  "durableTask": {
    "hubName": "SatelliteHub",
    "maxConcurrentActivityFunctions": 16,
    "maxConcurrentOrchestratorFunctions": 8,
    "extendedSessionsEnabled": true,
    "extendedSessionIdleTimeoutInSeconds": 300
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}